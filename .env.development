# Environment: Development
# Description: Environment variables for development environment
# Note: Do not commit sensitive information to version control
# VITE_TRAZZA_PLATFORM_API_URL version to be used when REST API is running on port 5222, otherwise use the one for port 3000
# VITE_TRAZZA_PLATFORM_API_URL="http://localhost:5222/api/v1"
VITE_TRAZZA_PLATFORM_API_URL="http://localhost:3000/api/v1"
# IAM & Profiles bounded context endpoints
VITE_USERS_ENDPOINT_PATH="/users"
VITE_CARRIER_PROFILES_ENDPOINT_PATH="/carrier-profiles"
VITE_MERCHANT_PROFILES_ENDPOINT_PATH="/merchant-profiles"
# Matchmaking & Routing bounded context endpoints
VITE_RETURN_ROUTES_ENDPOINT_PATH="/return-routes"
VITE_FREIGHT_REQUESTS_ENDPOINT_PATH="/freight-requests"
VITE_MATCH_PROPOSALS_ENDPOINT_PATH="/match-proposals"
# Service Execution & Monitoring bounded context endpoints
VITE_SHIPMENTS_ENDPOINT_PATH="/shipments"
# Payment & Billing bounded context endpoints
VITE_PAYMENT_TRANSACTIONS_ENDPOINT_PATH="/payment-transactions"
VITE_RECEIPTS_ENDPOINT_PATH="/receipts"
# Loyalty & Reputation bounded context endpoints
VITE_RATINGS_ENDPOINT_PATH="/ratings"
